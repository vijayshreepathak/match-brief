{
  "name": "dream11-matchbrief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "next build && playwright test",
    "verify:ai": "vitest run --config vitest.live.config.mts",
    "data:import": "node scripts/import-cricsheet.mjs",
    "verify:ai:browser": "next build && playwright test --config playwright.live.config.ts",
    "verify:ai:smoke": "vitest run --config vitest.live.config.mts -t smoke",
    "screenshots": "playwright test --config playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "description": "MatchBrief: catch up on a historical T20 chase with grounded AI explanations.",
  "engines": {
    "node": ">=22"
  }
}
