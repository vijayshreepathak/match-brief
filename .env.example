# Copy to .env.local (never commit .env.local).

# Required for AI mode. Without it the app still runs, using a clearly labelled
# rule-based fallback for recaps and answers.
OPENAI_API_KEY=

# Any model that supports the Responses API and Structured Outputs.
OPENAI_MODEL=gpt-5.4-mini

# Optional. Only sent when set. gpt-5.4-mini accepts: none, low, medium, high, xhigh.
# Leave empty for models that do not take a reasoning setting.
OPENAI_REASONING_EFFORT=low

# Optional. AI requests allowed per client IP per 10 minutes, per server instance (default 30).
MATCHBRIEF_AI_RATE_LIMIT=30
