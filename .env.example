# Copy to .env.local (never commit .env.local). Server-side only: never prefix with NEXT_PUBLIC_.

# Required for AI mode. Create a key in Google AI Studio (https://aistudio.google.com/apikey).
# Without it the app still runs, using a clearly labelled rule-based fallback.
# Only GEMINI_API_KEY is read; GOOGLE_API_KEY and any OPENAI_* variables are ignored.
GEMINI_API_KEY=

# Gemini model. Default: gemini-3.5-flash-lite (stable, structured output, thinking).
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional thinking level: minimal | low | medium | high. Sent only if the configured model
# documents that level (gemini-3.5-flash-lite supports all four; minimal is its default).
GEMINI_THINKING_LEVEL=minimal

# Optional. AI requests allowed per client IP per 10 minutes, per server instance (default 30).
MATCHBRIEF_AI_RATE_LIMIT=30
